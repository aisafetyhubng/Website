---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" showNewsletter={false}>
  <div class="page-head" style="border-bottom:0;padding-block:96px">
    <div class="wrap">
      <h1>We couldn't find that page</h1>
      <p class="lead">It may have moved, or the link may be mistyped.</p>
      <div class="acts left"><a class="btn btn-dark" href="/">Go to the homepage</a><a class="btn btn-outline" href="/events">See events</a></div>
    </div>
  </div>
</Base>
