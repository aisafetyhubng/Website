---
import Base from '../layouts/Base.astro';
import Quotes from '../components/Quotes.astro';
import { getContent } from '../lib/content';
import { getLatestPosts } from '../lib/substack';

const { site, programmes, stat, partners, upcomingEvents, recentEvents, recordings } = await getContent();
const posts = await getLatestPosts(site.substackFeed, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base page="home" showAnnouncement>
  <section class="hero" aria-label="Introduction">
    <canvas class="mosaic" aria-hidden="true"></canvas>
    <div class="wrap">
      <h1>Helping Nigerians find their way into <em>AI safety</em></h1>
      <p>{site.name} runs free fellowships, reading groups and events for students and early-career professionals who want to work on making AI go well.</p>
      <div class="ctas">
        <a class="btn btn-light" href="/programmes">Explore our programmes</a>
        <a class="btn btn-line" href="/about#why">Why AI safety matters</a>
      </div>
    </div>
  </section>

  <section class="partners-strip" aria-label="Our speakers and partners">
    <div class="wrap">
      <p class="partners-label">Our speakers and partners come from</p>
      <ul class="logos">
        {partners.map((p) => (
          <li>
            <a href={p.website} title={p.name} rel="noopener">
              <img src={p.logo} alt={p.name} style={`height:${p.height}px`} loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="head">
        <h2>What we do</h2>
        <a class="link" href="/programmes">All programmes →</a>
      </div>
      <div class="tiles">
        {programmes.map((p) => (
          <a class={`tile ${p.tile}`} href={p.href}>
            <h3>{p.name}{p.nameItalic && <> <em>{p.nameItalic}</em></>}</h3>
            <p>{p.tileText}</p>
            <div class="when">{p.status && <><b>{p.status}</b><br /></>}{p.statusDetail}</div>
            <span class="go">{p.linkLabel}</span>
          </a>
        ))}
      </div>

      <div class="stat-band">
        <div class="big">{stat.number}</div>
        <div class="txt">
          <p>{stat.text}</p>
          <small>{stat.detail}</small>
        </div>
        <a class="btn" href={stat.href}>{stat.linkLabel}</a>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="head"><h2>From our seminars</h2></div>
      <Quotes />
    </div>
  </section>

  <section class="sec">
    <div class="wrap split">
      <div>
        <h2>Upcoming events</h2>
        <p class="lead">We host online and in-person events on AI safety, governance and careers, open to anyone in Nigeria and beyond.</p>
        <div class="acts">
          <a class="btn btn-dark" href="/events">See all events</a>
          <a class="link" href={site.links.luma}>Subscribe on Luma ↗</a>
          {recordings.length > 0 && <a class="link" href="/events#recordings">Watch past talks →</a>}
        </div>
      </div>
      <div class="ev-cards">
        {upcomingEvents.map((e) => (
          <a class="ev-card" href={e.href ?? '/events'}>
            <div class="d next"><b>{e.day}</b><small>{e.month}</small></div>
            <div><h3>{e.title}</h3><p>{e.details}</p></div>
          </a>
        ))}
        {recentEvents.map((e) => (
          <a class="ev-card" href={e.href ?? '/events'}>
            <div class="d"><b>{e.day}</b><small>{e.month}</small></div>
            <div><h3>{e.title}</h3><p>{e.details}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <div class="head">
          <h2>From the newsletter</h2>
          <a class="link" href={site.links.substack}>All issues ↗</a>
        </div>
        <div class:list={['posts', { few: posts.length < 3 }]}>
          {posts.map((p) => (
            <a class="post" href={p.link}>
              <span class="label">{fmt(p.date)}</span>
              <h3>{p.title}</h3>
              {p.excerpt && <p>{p.excerpt}</p>}
              <span class="go">Read the issue →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
