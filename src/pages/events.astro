---
import Base from '../layouts/Base.astro';
import { brand } from '../../brand.config.mjs';
import EventRow from '../components/EventRow.astro';
import Video from '../components/Video.astro';
import { getContent } from '../lib/content';
const { site, upcomingEvents, pastEventCards, featuredPastEvent, earlierEvents, recordings } = await getContent();
const lumaEmbed = `https://luma.com/embed/calendar/${site.lumaCalendarId}/events`;
---
<Base title="Events" page="events" description={`Talks, seminars, recordings and community events from ${brand.name}, online and in person.`}>
  <div class="page-head" style="border-bottom:0;padding-bottom:8px">
    <div class="wrap">
      <div class="top">
        <div>
          <h1>Events</h1>
          <p class="lead">Talks, seminars and community events on AI safety, online and in person. Everything is free and open to all.</p>
        </div>
        <div class="acts">
          <a class="btn btn-dark" href={site.links.luma}>Subscribe on Luma</a>
          <a class="link" href={site.links.linkedinPosts}>Event recaps on LinkedIn ↗</a>
        </div>
      </div>
      <nav class="anchors" aria-label="On this page">
        <a href="#next">Next up</a>
        <a href="#calendar">Calendar</a>
        {recordings.length > 0 && <a href="#recordings">Recordings</a>}
        <a href="#past">Previous events</a>
      </nav>
    </div>
  </div>

  <section class="sec" id="next" style="padding-top:20px">
    <div class="wrap">
      <div class="head" style="margin-bottom:12px"><h2>Next up</h2></div>
      <div class="events">
        {upcomingEvents.length > 0
          ? upcomingEvents.map((e) => <EventRow event={e} next />)
          : <p class="lead" style="padding:16px 0">New events are announced on <a href={site.links.luma}>Luma</a> and in our newsletter. Subscribe to hear first.</p>}
      </div>
    </div>
  </section>

  <section class="sec" id="calendar">
    <div class="wrap">
      <div class="head" style="margin-bottom:12px">
        <h2>Calendar</h2>
        <a class="link" href={site.links.luma}>Open in Luma ↗</a>
      </div>
      <iframe class="luma" src={lumaEmbed} title={`${brand.name} events calendar on Luma`} loading="lazy" allowfullscreen></iframe>
    </div>
  </section>

  {recordings.length > 0 && (
    <section class="sec" id="recordings">
      <div class="wrap">
        <div class="head">
          <div>
            <h2>Recordings</h2>
            <p class="lead">Missed a session? Watch our past talks and seminars.</p>
          </div>
          {site.links.youtube && <a class="link" href={site.links.youtube}>All recordings on YouTube ↗</a>}
        </div>
        <div class="videos">
          {recordings.map((v) => <Video video={v} />)}
        </div>
      </div>
    </section>
  )}

  <section class="sec" id="past">
    <div class="wrap">
      <div class="head">
        <h2>Previous events</h2>
        <a class="link" href={site.links.linkedinPosts}>Recaps on LinkedIn ↗</a>
      </div>
      <div class="cards">
        {pastEventCards.map((c) => (
          <a class="card-ev" href={c.href}>
            <img class="thumb-img" src={c.image} alt={c.alt} width="800" height="450" loading="lazy" />
            <h3>{c.title}</h3>
            <span class="label">{c.date}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {featuredPastEvent && (
    <section class="sec">
      <div class="wrap feature">
        <div>
          <span class="label">{featuredPastEvent.kicker}</span>
          <h3>{featuredPastEvent.title}</h3>
          <dl class="facts">
            {featuredPastEvent.facts.map((f) => (
              <div><dt>{f.label}</dt><dd>{f.big && <b>{f.big}</b>}{f.text}</dd></div>
            ))}
          </dl>
          <div class="links">
            <a class="link" href={site.links.apexProgram}>About APEx →</a>
            <a class="link" href={site.links.apexCurriculum}>Open curriculum →</a>
          </div>
        </div>
        <div class="photos">
          {featuredPastEvent.photos.map((p) => <img class="photo" src={p.src} alt={p.alt} width="720" height="553" loading="lazy" />)}
        </div>
      </div>
    </section>
  )}

  {earlierEvents.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <div class="head" style="margin-bottom:12px"><h2>Earlier</h2></div>
        <div class="events">
          {earlierEvents.map((e) => <EventRow event={e} />)}
        </div>
      </div>
    </section>
  )}
</Base>
