---
import { site } from '../data/site';
// Posts to Substack's own subscribe endpoint, which opens Substack in a new tab to confirm the subscription.
const action = new URL('api/v1/free?nojs=true', site.links.substack).toString();
---
<section class="news">
  <div class="wrap">
    <div>
      <h2>Stay up to date</h2>
      <p class="intro">Our newsletter covers open applications, upcoming events and AI safety opportunities for people in Nigeria.</p>
    </div>
    <div>
      <form class="sub-form" action={action} method="post" target="_blank" novalidate>
        <label for="email" class="sr-only">Email address</label>
        <input id="email" name="email" type="email" placeholder="Your email address" autocomplete="email" required />
        <button class="btn btn-dark" type="submit">Subscribe</button>
      </form>
      <p class="form-msg" aria-live="polite"></p>
      <p class="fine">Sent through <a href={site.links.substack}>Substack</a>. Unsubscribe any time.</p>
    </div>
  </div>
</section>
