---
import Logo from './Logo.astro';
import { getContent } from '../lib/content';
const { site } = await getContent();
const year = new Date().getFullYear();
---
<footer class="site">
  <div class="wrap">
    <div class="fcols">
      <div>
        <Logo white />
        <p class="about">Helping people in Nigeria find their way into AI safety research, governance and policy.</p>
      </div>
      <div>
        <h4>About</h4>
        <ul>
          <li><a href="/about">About us</a></li>
          <li><a href="/about#team">Our team</a></li>
          <li><a href="/about#support">Donate</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Programmes</h4>
        <ul>
          <li><a href={site.links.apexProgram}>APEx Fellowship</a></li>
          <li><a href={site.links.readingGroup}>Reading group</a></li>
          <li><a href={site.links.apexCurriculum}>APEx curriculum</a></li>
        </ul>
      </div>
      <div>
        <h4>Community</h4>
        <ul>
          <li><a href="/events">Events</a></li>
          <li><a href={site.links.substack}>Newsletter</a></li>
          <li><a href={site.links.apexSurvey}>APEx survey</a></li>
        </ul>
      </div>
      <div>
        <h4>Follow</h4>
        <ul>
          <li><a href={site.links.linkedin}>LinkedIn</a></li>
          <li><a href={site.links.instagram}>Instagram</a></li>
          <li><a href={site.links.substack}>Substack</a></li>
          {site.links.youtube && <li><a href={site.links.youtube}>YouTube</a></li>}
        </ul>
      </div>
    </div>
    <div class="base">
      <span>© {year} {site.name} · {site.email}</span>
      <span>A non-profit organisation · {site.location}</span>
    </div>
  </div>
</footer>
