---
/** The logo mark, made from the organisation's logo (see tools/make-icons.ps1). */
interface Props { white?: boolean; class?: string }
const { white = false, class: cls } = Astro.props;
---
<img class:list={['logo-mark', cls]} src={white ? '/img/logo-mark-white.png' : '/img/logo-mark.png'} alt="" width="38" height="38" />
