---
import LogoMark from './LogoMark.astro';
import { brand } from '../../brand.config.mjs';
interface Props { white?: boolean }
const { white = false } = Astro.props;
const [line1, line2] = brand.logoLines;
---
<a class="logo" href="/" aria-label={`${brand.name} home`}><LogoMark white={white} /><span>{line1}{line2 && <><br />{line2}</>}</span></a>
